# Local-only model configuration. Never commit real credentials.
SWAPSHIELD_VLM_MODEL=Qwen/Qwen3-VL-4B-Instruct
SWAPSHIELD_VISION_MODEL=facebook/dinov2-small
SWAPSHIELD_DEVICE=cuda
SWAPSHIELD_VLM_4BIT=true
SWAPSHIELD_VLM_MAX_PIXELS=262144
SWAPSHIELD_VLM_OOM_RETRY_PIXELS=131072
SWAPSHIELD_REVIEW_THRESHOLD=0.68
SWAPSHIELD_MIN_IMAGE_QUALITY=0.46
# Versioned fusion model generated by the locked v1 benchmark.
SWAPSHIELD_FUSION_MODEL=evaluation/results/fusion-model.json
SWAPSHIELD_DEBUG_MODEL_OUTPUT=false
SWAPSHIELD_MAX_UPLOAD_BYTES=12582912
SWAPSHIELD_MAX_IMAGE_PIXELS=30000000

# Optional OpenAI-compatible evidence-auditor API. Leave URL/model empty to use
# the safe deterministic fallback. Never commit the real API key.
SWAPSHIELD_AUDITOR_URL=
SWAPSHIELD_AUDITOR_MODEL=
SWAPSHIELD_AUDITOR_API_KEY=
SWAPSHIELD_AUDITOR_TIMEOUT_SECONDS=45

# Browser dashboard connection to the local FastAPI service.
NEXT_PUBLIC_SWAPSHIELD_API_URL=http://127.0.0.1:8000
